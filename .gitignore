/rpkv
*.test
/rpkv-data/

# per-package integration-test env overrides, loaded by rptest.Main (ADR-006)
.env

# agent worktrees, receipts, and local state; settings.json must stay
# committable since it wires the Stop hook
/.claude/*
!/.claude/settings.json

# Agent definitions are vendored, for the same reason scripts/ is: they hold
# the delegation and quality-pass clauses that were previously re-typed into
# every prompt, and a retyping is a chance to drift. Pinned `model: sonnet`
# lives here too, so the rule stops depending on a session remembering it.
!/.claude/agents/
